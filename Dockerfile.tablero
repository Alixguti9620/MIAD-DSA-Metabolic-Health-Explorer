# Tablero (Streamlit). Construir desde la raiz del repositorio:
#   docker build -f Dockerfile.tablero -t metabolic-tablero .
# Las predicciones se piden a la API: definir API_URL al ejecutar.
FROM python:3.11-slim

ARG VERSION_CODIGO=sin_git
ENV VERSION_CODIGO=${VERSION_CODIGO} PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    API_URL=http://api:8000

WORKDIR /app
COPY requirements-tablero.txt .
RUN pip install --no-cache-dir -r requirements-tablero.txt

COPY src/ src/
COPY app/ app/
COPY .streamlit/ .streamlit/
COPY data/raw/NHANES_consolidado.csv data/raw/NHANES_consolidado.csv
COPY reports/figures/ reports/figures/
COPY docs/evidencias_mlflow/ docs/evidencias_mlflow/

# Metadatos y metricas que muestra la pantalla "Modelo y datos".
RUN python src/entrenar_modelos.py

RUN useradd --create-home appuser && chown -R appuser /app
USER appuser

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4).status == 200 else 1)"
CMD ["streamlit", "run", "app/tablero.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
